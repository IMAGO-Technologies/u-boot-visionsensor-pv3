#include <env/nxp/imx_env.env>

initrd_addr=0x93800000
initrd_high=0xffffffffffffffff
initrd_file=initrd.img
boot_devices_mmcblk0=soc/42800000.bus/42850000.mmc
boot_devices_mmcblk1=soc/42800000.bus/42860000.mmc
kernel_addr_r=${loadaddr}
bootfile=Image.gz
console=ttyLP0,115200 earlycon
fdt_addr=0x93000000
fdtfile=CONFIG_DEFAULT_FDT_FILE
bootm_size=0x10000000
mmcdev=CONFIG_SYS_MMC_ENV_DEV
mmcpart=1
mmcroot=/dev/mmcblk0p2 rootwait rw
mmcargs=setenv bootargs ${optargs} console=${console} root=${mmcroot} fsck.repair=yes quiet
script=boot.scr
loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};
bootscript=echo Running bootscript from mmc ...; source
loadbootenv=if test -e mmc ${mmcdev}:${mmcpart} uEnv.txt; then
				load mmc ${mmcdev}:${mmcpart} ${loadaddr} uEnv.txt;
			fi;
envboot=if run loadbootenv; then
			echo Loaded env from uEnv.txt;
			env import -t ${loadaddr} ${filesize};
			if test -n $uenvcmd; then
				echo Running uenvcmd ...;
				run uenvcmd;
			fi;
		fi;
loadimage=fatload mmc ${mmcdev}:${mmcpart} ${initrd_addr} ${bootfile}
loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdtfile}
loadinitrd=if test -n ${initrd_file}; then
			if test -e mmc ${mmcdev}:${mmcpart} ${initrd_file}; then
				echo Loading ${initrd_file};
				load mmc ${mmcdev}:${mmcpart} ${initrd_addr} ${initrd_file};
			fi;
		fi;
mmcboot=echo Booting from mmc ...;
		run mmcargs;
		run loadfdt;
		unzip ${initrd_addr} ${kernel_addr_r};
		if run loadinitrd; then
			booti ${kernel_addr_r} ${initrd_addr}:${filesize} ${fdt_addr};
		else
			booti ${kernel_addr_r} - ${fdt_addr};
		fi;
bootcmd=echo Running bootcmd ...;
		mmc dev ${mmcdev}; if mmc rescan; then
			if run loadbootscript; then
				run bootscript;
			else
				run envboot;
				if run loadimage; then
					run mmcboot;
				fi;
			fi;
		fi;

